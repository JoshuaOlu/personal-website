---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">
  <title>{{ site.title | xml_escape }}: writing</title>
  <subtitle>{{ site.description | normalize_whitespace | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/writing/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/writing/' | absolute_url }}</id>
  {%- assign posts = site.writing | sort: "date" | reverse -%}
  <updated>{% if posts.size > 0 %}{{ posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.data.identity.name | xml_escape }}</name><uri>{{ site.url }}/</uri></author>
  {%- for post in posts limit: 30 %}
  {%- include cite-apply.html html=post.content slug=post.slug %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.updated | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.summary | default: post.description | normalize_whitespace | xml_escape }}</summary>
    <content type="html">{{ cited_html | append: cited_refs | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
